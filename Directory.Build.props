<Project>

  <!--
    Bütün projeler için ortak ayarlar. Tek yerde durmasının sebebi:
    MAUI projeleri (Android/iOS hedefli) ile saf kütüphaneler arasında
    dil sürümü ve nullable davranışının ayrışmasını engellemek.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Uygulamanın nötr (yedek) dili İngilizce; tr ve de uydu kaynak
         dosyalarıyla gelir. Bkz. src/Ploofy.App/Resources/Strings. -->
    <NeutralLanguage>en</NeutralLanguage>

    <Company>Ploofy</Company>
    <Product>Ploofy</Product>
  </PropertyGroup>

  <!--
    Uyarılar sessizce birikmesin. Kural yalnızca kendi yazdığımız saf
    katmanlarda sıkı: MAUI projelerinde XAML ve platform bağlayıcılarının
    ürettiği kod kendi uyarılarını getiriyor, onları hata saymak derlemeyi
    bizimle ilgisi olmayan sebeplerle kırıyor.
  -->
  <PropertyGroup Condition="'$(UseMaui)' != 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Makineye özel araç yolları (Android SDK, JDK 17). Bu dosya depoya
    girmiyor: her geliştiricinin yolu farklı ve birinin yolu diğerinin
    derlemesini kırar. Örnek içerik README'de.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Ploofy.local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Ploofy.local.props')" />

</Project>
