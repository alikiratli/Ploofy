<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Ploofy.Engine\Ploofy.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />

    <!--
      bundle_green 2.1.11 kendi içinde SQLite'ın açıklı bir sürümünü taşıyor
      (GHSA-2m69-gcr7-jv3q, yüksek). Paketin 2.1.11'den yenisi yok, ama
      taşıdığı yerel kütüphanenin var: lib.e_sqlite3 2.1.13. Doğrudan
      referans vererek geçişli sürümü eziyoruz — aynı 2.1.x hattı, API
      değişmiyor. bundle_green yenilendiğinde bu satır kaldırılabilir.
    -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
