<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Ploofy.App.Localization"
             xmlns:ui="clr-namespace:Ploofy.Ui.Controls;assembly=Ploofy.Ui"
             xmlns:vm="clr-namespace:Ploofy.App.ViewModels"
             x:Class="Ploofy.App.Views.PatternPage"
             x:Name="Page"
             x:DataType="vm:PatternViewModel"
             Background="{StaticResource PageBackdrop}">

    <Grid>
        <Grid RowDefinitions="Auto,*,Auto" Padding="{StaticResource PagePadding}" RowSpacing="14">

            <!-- Bilgi şeridi -->
            <Border Grid.Row="0"
                    Padding="14,10"
                    StrokeShape="RoundRectangle 26"
                    Stroke="Transparent"
                    BackgroundColor="#F2FFFFFF">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">

                    <Label Grid.Column="0"
                           Text="{Binding PlayerAvatar}"
                           FontSize="26"
                           VerticalOptions="Center" />

                    <Label Grid.Column="1"
                           Text="{Binding PlayerName}"
                           FontSize="19"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />

                    <FlexLayout Grid.Column="2"
                                BindableLayout.ItemsSource="{Binding Pips}"
                                Wrap="Wrap"
                                JustifyContent="Center"
                                AlignItems="Center"
                                VerticalOptions="Center">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProgressPip">
                                <Label Text="●"
                                       FontSize="15"
                                       Margin="2,0"
                                       TextColor="{Binding Fill}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Label Grid.Column="3"
                           IsVisible="{Binding ShowsProgressCounter}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource InkMuted}"
                           VerticalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Completed}" />
                                <Span Text=" / " />
                                <Span Text="{Binding Total}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Button Grid.Column="4"
                            Text="✕"
                            Style="{StaticResource RoundIconButton}"
                            WidthRequest="48"
                            HeightRequest="48"
                            CornerRadius="24"
                            FontSize="18"
                            Command="{Binding QuitCommand}" />
                </Grid>
            </Border>

            <!-- Dizi. Yatayda ortalanmış tek satır: örüntü ancak soldan sağa
                 kesintisiz okunduğunda görülüyor, satır kırılırsa kaybolur. -->
            <Border Grid.Row="1"
                    VerticalOptions="Center"
                    Padding="16,20"
                    StrokeShape="RoundRectangle 30"
                    Stroke="Transparent"
                    BackgroundColor="#B3FFFFFF">
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Sequence}"
                                           Spacing="8"
                                           HorizontalOptions="Center">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PatternSlot">
                                <ui:ShapeTileView Kind="{Binding Kind}"
                                                  Hue="{Binding Hue}"
                                                  IsEmpty="{Binding IsEmpty}"
                                                  IsWaiting="{Binding IsEmpty}"
                                                  WidthRequest="86"
                                                  HeightRequest="86" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
            </Border>

            <!-- Seçenekler. Dokunma hedefi 96 birim: dizideki kutucuktan
                 büyük, çünkü basılacak olan bunlar. -->
            <VerticalStackLayout Grid.Row="2" Spacing="8">
                <Label Text="{loc:Translate PatternHint}"
                       Style="{StaticResource HintLabel}"
                       HorizontalTextAlignment="Center" />

                <FlexLayout BindableLayout.ItemsSource="{Binding Options}"
                            Wrap="Wrap"
                            JustifyContent="Center"
                            AlignItems="Center">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PatternOption">
                            <Border Margin="8"
                                    Padding="6"
                                    StrokeShape="RoundRectangle 28"
                                    Stroke="Transparent"
                                    BackgroundColor="#F2FFFFFF">
                                <Border.Shadow>
                                    <Shadow Brush="#38402A1E" Offset="0,6" Radius="14" Opacity="0.55" />
                                </Border.Shadow>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.ChooseCommand, x:DataType=ContentPage}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <ui:ShapeTileView Kind="{Binding Kind}"
                                                  Hue="{Binding Hue}"
                                                  State="{Binding State}"
                                                  WidthRequest="96"
                                                  HeightRequest="96"
                                                  InputTransparent="True" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </Grid>

        <!-- Devir katmanı -->
        <Grid IsVisible="{Binding ShowsHandoff}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFC845" Offset="0.0" />
                    <GradientStop Color="#FF8C42" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ConfirmHandoffCommand}" />
            </Grid.GestureRecognizers>

            <VerticalStackLayout VerticalOptions="Center" Spacing="16" Padding="32">
                <Label Text="👋" FontSize="76" HorizontalOptions="Center" />
                <Label Text="{Binding HandoffText}"
                       Style="{StaticResource TitleLabel}"
                       TextColor="White"
                       HorizontalTextAlignment="Center" />
                <Label Text="{loc:Translate HandoffHint}"
                       FontSize="17"
                       TextColor="#F0FFFFFF"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
