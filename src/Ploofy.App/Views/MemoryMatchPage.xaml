<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Ploofy.App.Localization"
             xmlns:ui="clr-namespace:Ploofy.Ui.Controls;assembly=Ploofy.Ui"
             xmlns:vm="clr-namespace:Ploofy.App.ViewModels"
             x:Class="Ploofy.App.Views.MemoryMatchPage"
             x:Name="Page"
             x:DataType="vm:MemoryMatchViewModel">

    <Grid>
        <Grid RowDefinitions="Auto,*" Padding="{StaticResource PagePadding}" RowSpacing="14">

            <!-- Üst şerit: kim oynuyor, kaç çift kaldı -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12,8">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                    <Label Grid.Column="0" Text="{Binding PlayerAvatar}" FontSize="30" VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding PlayerName}"
                           FontSize="20"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />

                    <!-- Sayaç yalnızca yazının anlamlı olduğu bantlarda görünüyor. -->
                    <Label Grid.Column="2"
                           HorizontalOptions="End"
                           VerticalOptions="Center"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource InkMuted}"
                           IsVisible="{Binding ShowsProgressCounter}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding MatchedPairs}" />
                                <Span Text=" / " />
                                <Span Text="{Binding TotalPairs}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Button Grid.Column="3"
                            Text="✕"
                            Style="{StaticResource RoundIconButton}"
                            WidthRequest="48"
                            HeightRequest="48"
                            CornerRadius="24"
                            FontSize="18"
                            Command="{Binding QuitCommand}" />
                </Grid>
            </Border>

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Cards}"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="{Binding Columns}"
                                     HorizontalItemSpacing="10"
                                     VerticalItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MemoryCardVm">
                        <!-- Çevirme animasyonu kontrolün içinde; şablon yalnızca
                             durumu bağlıyor. -->
                        <ui:MemoryCardView Symbol="{Binding Symbol}"
                                           IsRevealed="{Binding IsRevealed}"
                                           IsMatched="{Binding IsMatched}"
                                           HeightRequest="100">
                            <ui:MemoryCardView.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.FlipCommand, x:DataType=ContentPage}"
                                    CommandParameter="{Binding .}" />
                            </ui:MemoryCardView.GestureRecognizers>
                        </ui:MemoryCardView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Devir katmanı: sıra kardeşe geçerken tahtayı tamamen kapatıyor.
             Kapatmasa, sırası gelen çocuk önceki turun kartlarını görürdü. -->
        <Grid IsVisible="{Binding ShowsHandoff}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFC845" Offset="0.0" />
                    <GradientStop Color="#FF8C42" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ConfirmHandoffCommand}" />
            </Grid.GestureRecognizers>

            <VerticalStackLayout VerticalOptions="Center" Spacing="16" Padding="32">
                <Label Text="👋" FontSize="76" HorizontalOptions="Center" />
                <Label Text="{Binding HandoffText}"
                       Style="{StaticResource TitleLabel}"
                       TextColor="White"
                       HorizontalTextAlignment="Center" />
                <Label Text="{loc:Translate HandoffHint}"
                       FontSize="17"
                       TextColor="#F0FFFFFF"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
