<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Ploofy.App.Localization"
             xmlns:ui="clr-namespace:Ploofy.Ui.Controls;assembly=Ploofy.Ui"
             xmlns:vm="clr-namespace:Ploofy.App.ViewModels"
             x:Class="Ploofy.App.Views.SettingsPage"
             x:Name="Page"
             x:DataType="vm:SettingsViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="22">

            <Label Text="{loc:Translate SettingsTitle}" Style="{StaticResource TitleLabel}" />

            <!-- Abonelik: burada yalnızca özet durur. Ayrıntı, mağaza
                 bağlantısı ve bitirme yolu abonelik ekranında. -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{loc:Translate SettingsSubscription}"
                               Style="{StaticResource SectionLabel}"
                               VerticalOptions="Center" />
                        <Border Grid.Column="1"
                                BackgroundColor="{Binding SubscriptionBadgeColor}"
                                StrokeThickness="0"
                                Padding="12,4"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="999" />
                            </Border.StrokeShape>
                            <Label Text="{Binding SubscriptionBadgeText}"
                                   TextColor="{StaticResource OnAccent}"
                                   FontSize="13"
                                   FontAttributes="Bold" />
                        </Border>
                    </Grid>

                    <Label Text="{Binding SubscriptionStatusText}" Style="{StaticResource HintLabel}" />

                    <Label Text="{Binding SubscriptionPeriodText}"
                           Style="{StaticResource HintLabel}"
                           IsVisible="{Binding HasSubscription}" />

                    <Button Text="{loc:Translate SubscriptionCta}"
                            Style="{StaticResource AccentButton}"
                            IsVisible="{Binding CanSubscribe}"
                            Command="{Binding ManageSubscriptionCommand}" />

                    <Button Text="{loc:Translate SettingsManageSubscription}"
                            Style="{StaticResource QuietButton}"
                            Command="{Binding ManageSubscriptionCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Rapor: çocuğun ne oynadığı. Aboneliğin hemen altında,
                 çünkü ebeveynin karşılığını gördüğü ikinci yer burası. -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate SettingsReport}" Style="{StaticResource SectionLabel}" />
                    <Label Text="{loc:Translate ReportPrivacy}" Style="{StaticResource HintLabel}" />
                    <Button Text="{loc:Translate SettingsReport}"
                            Style="{StaticResource QuietButton}"
                            Command="{Binding OpenReportCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Ses ve titreşim -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto" HeightRequest="{StaticResource TouchTarget}">
                        <Label Text="{loc:Translate SettingsSound}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding SoundEnabled}" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" HeightRequest="{StaticResource TouchTarget}">
                        <Label Text="{loc:Translate SettingsHaptics}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding HapticsEnabled}" VerticalOptions="Center" />
                    </Grid>

                    <!-- Ses anahtarının hemen yanında bir örnek: ebeveyn
                         cihazın hoparlöründe duymadan karar veremiyor. -->
                    <Button Text="{loc:Translate SettingsSoundTest}"
                            Style="{StaticResource QuietButton}"
                            IsEnabled="{Binding SoundEnabled}"
                            Command="{Binding PlaySoundSampleCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Dil -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate SettingsLanguage}" Style="{StaticResource SectionLabel}" />
                    <Picker ItemsSource="{Binding LanguageChoices}"
                            SelectedItem="{Binding SelectedLanguage}"
                            ItemDisplayBinding="{Binding Label, x:DataType=vm:LanguageOption}"
                            FontSize="18"
                            HeightRequest="{StaticResource TouchTarget}" />
                </VerticalStackLayout>
            </Border>

            <!-- Profiller -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate SettingsProfiles}" Style="{StaticResource SectionLabel}" />

                    <CollectionView ItemsSource="{Binding Profiles}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileRow">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                      ColumnSpacing="12"
                                      HeightRequest="{StaticResource TouchTarget}">
                                    <ui:AvatarBadgeView Grid.Column="0"
                                                        Avatar="{Binding AvatarId}"
                                                        Size="46"
                                                        VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding DisplayName}" FontAttributes="Bold" />
                                        <Label Text="{Binding BandName}" Style="{StaticResource HintLabel}" />
                                    </VerticalStackLayout>
                                    <!-- Düzenleme: avatar, ad ve yaş bandı profil
                                         kurulduktan sonra da değişebilir. Çocuk
                                         büyüyor ve profili silip yeniden kurmak
                                         bütün yıldızlarını götürüyordu.
                                         Kalem, çöp kutusunun yanında renkli
                                         durabilmek için VS16 ile yazılıyor;
                                         çıplak U+270F cihazda soluk bir çizgi
                                         olarak çıkıyor ve düğme boş görünüyor. -->
                                    <Button Grid.Column="2"
                                            Text="&#x270F;&#xFE0F;"
                                            FontSize="18"
                                            WidthRequest="52"
                                            HeightRequest="52"
                                            CornerRadius="26"
                                            Padding="0"
                                            BackgroundColor="{StaticResource SurfaceMuted}"
                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.EditProfileCommand, x:DataType=ContentPage}"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="3"
                                            Text="🗑"
                                            FontSize="18"
                                            WidthRequest="52"
                                            HeightRequest="52"
                                            CornerRadius="26"
                                            Padding="0"
                                            BackgroundColor="{StaticResource SurfaceMuted}"
                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.DeleteProfileCommand, x:DataType=ContentPage}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Gizlilik: bu metin ürünün taahhüdü, süs değil. -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate SettingsPrivacy}" Style="{StaticResource SectionLabel}" />
                    <Label Text="{loc:Translate SettingsPrivacyBody}" Style="{StaticResource HintLabel}" />
                </VerticalStackLayout>
            </Border>

            <!-- Hakkında ve yasal. İki bağlantı da tarayıcıya çıkıyor ve
                 ebeveyn kilidinin arkasında; adresler PloofyLinks'te. -->
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate SettingsAbout}" Style="{StaticResource SectionLabel}" />
                    <Label Text="{Binding VersionText}" Style="{StaticResource HintLabel}" />
                    <Label Text="{loc:Translate SettingsLegalHint}" Style="{StaticResource HintLabel}" />

                    <Button Text="{loc:Translate SettingsLegalPrivacy}"
                            Style="{StaticResource QuietButton}"
                            Command="{Binding OpenPrivacyPolicyCommand}" />

                    <Button Text="{loc:Translate SettingsLegalImprint}"
                            Style="{StaticResource QuietButton}"
                            Command="{Binding OpenImprintCommand}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="{loc:Translate CommonClose}"
                    Style="{StaticResource BigButton}"
                    Command="{Binding CloseCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
