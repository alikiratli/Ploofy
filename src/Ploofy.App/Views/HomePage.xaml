<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Ploofy.App.Localization"
             xmlns:ui="clr-namespace:Ploofy.Ui.Controls;assembly=Ploofy.Ui"
             xmlns:vm="clr-namespace:Ploofy.App.ViewModels"
             x:Class="Ploofy.App.Views.HomePage"
             x:Name="Page"
             x:DataType="vm:HomeViewModel">

    <ContentPage.Resources>
        <!-- Eğlendirici ve öğretici bölümler aynı kutucuğu kullanıyor. -->
        <DataTemplate x:Key="GameTileTemplate" x:DataType="vm:GameTile">
            <Border Style="{StaticResource TileBorder}"
                    Background="{Binding Background}"
                    HeightRequest="164"
                    Opacity="{Binding TileOpacity}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenCommand, x:DataType=ContentPage}"
                        CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>

                <Grid RowDefinitions="*,Auto">

                    <!-- Simgenin altındaki açık daire: simgeyi renkli zeminden
                         ayırıyor ve kutucuğa derinlik veriyor. -->
                    <Border Grid.Row="0"
                            WidthRequest="86"
                            HeightRequest="86"
                            Padding="0"
                            StrokeThickness="0"
                            BackgroundColor="#59FFFFFF"
                            StrokeShape="RoundRectangle 43"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Label Text="{Binding Glyph}"
                               FontSize="44"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Kilit rozeti: okuma bilmeyen çocuk için asma kilit. -->
                    <Border Grid.Row="0"
                            IsVisible="{Binding IsLocked}"
                            WidthRequest="38"
                            HeightRequest="38"
                            Padding="0"
                            StrokeThickness="0"
                            BackgroundColor="#D9FFFFFF"
                            StrokeShape="RoundRectangle 19"
                            HorizontalOptions="End"
                            VerticalOptions="Start">
                        <Label Text="🔒" FontSize="19" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <Border Grid.Row="0"
                            IsVisible="{Binding ShowsFreeBadge}"
                            Padding="8,3"
                            StrokeThickness="0"
                            BackgroundColor="#E6FFFFFF"
                            StrokeShape="RoundRectangle 12"
                            HorizontalOptions="Start"
                            VerticalOptions="Start">
                        <Label Text="{loc:Translate GameFree}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Ink}" />
                    </Border>

                    <Border Grid.Row="0"
                            IsVisible="{Binding ShowsComingSoon}"
                            Padding="8,3"
                            StrokeThickness="0"
                            BackgroundColor="#D9FFFFFF"
                            StrokeShape="RoundRectangle 12"
                            HorizontalOptions="End"
                            VerticalOptions="Start">
                        <Label Text="{loc:Translate ComingSoon}"
                               FontSize="12"
                               TextColor="{StaticResource Ink}" />
                    </Border>

                    <VerticalStackLayout Grid.Row="1" Spacing="3">
                        <Label Text="{Binding Name}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Ink}"
                               HorizontalTextAlignment="Center"
                               MaxLines="2"
                               LineBreakMode="TailTruncation" />
                        <ui:StarRow Stars="{Binding Stars}"
                                    StarSize="15"
                                    HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="{StaticResource PagePadding}" RowSpacing="14">

        <!-- Üst şerit: kim oynuyor, kaç yıldızı var -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14,10">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SwitchProfileCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <ui:AvatarBadgeView Grid.Column="0"
                                    Avatar="{Binding ChildAvatar}"
                                    Size="54" />

                <Label Grid.Column="1"
                       Text="{Binding ChildName}"
                       FontSize="22"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />

                <!-- Yıldız rozeti koleksiyonu açıyor. Yanındaki soluk avatar
                     sıradaki ödül: rozeti bir düğmeye benzetiyor ve yıldızın
                     ne işe yaradığını ekranın kendisinde söylüyor. -->
                <Border Grid.Column="2"
                        Padding="12,6"
                        StrokeThickness="0"
                        Background="{StaticResource Card1Brush}"
                        StrokeShape="RoundRectangle 18"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenCollectionCommand}" />
                    </Border.GestureRecognizers>

                    <HorizontalStackLayout Spacing="8">
                        <Label Text="{Binding TotalStars, Converter={StaticResource FormatWith}, ConverterParameter=TotalStars}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Ink}"
                               VerticalOptions="Center" />

                        <Label Text="{Binding NextRewardAvatar}"
                               FontSize="18"
                               Opacity="0.5"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16">

                <Label Text="{loc:Translate HomeTitle}" Style="{StaticResource TitleLabel}" />

                <Label Text="{loc:Translate SectionFun}" Style="{StaticResource SectionLabel}" />
                <CollectionView ItemsSource="{Binding FunGames}"
                                ItemTemplate="{StaticResource GameTileTemplate}"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="{Binding GameColumns}"
                                         HorizontalItemSpacing="14"
                                         VerticalItemSpacing="14" />
                    </CollectionView.ItemsLayout>
                </CollectionView>

                <Label Text="{loc:Translate SectionEducational}"
                       Style="{StaticResource SectionLabel}"
                       IsVisible="{Binding HasEducationalGames}" />
                <CollectionView ItemsSource="{Binding EducationalGames}"
                                ItemTemplate="{StaticResource GameTileTemplate}"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="{Binding GameColumns}"
                                         HorizontalItemSpacing="14"
                                         VerticalItemSpacing="14" />
                    </CollectionView.ItemsLayout>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
