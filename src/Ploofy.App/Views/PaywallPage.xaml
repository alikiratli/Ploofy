<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Ploofy.App.Localization"
             xmlns:vm="clr-namespace:Ploofy.App.ViewModels"
             x:Class="Ploofy.App.Views.PaywallPage"
             x:DataType="vm:PaywallViewModel">

    <Grid RowDefinitions="*,Auto" Padding="{StaticResource PagePadding}" RowSpacing="20">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="18">

                <Label Text="🌟" FontSize="64" HorizontalOptions="Center" />

                <Label Text="{loc:Translate SubscriptionTitle}"
                       Style="{StaticResource TitleLabel}"
                       HorizontalTextAlignment="Center" />

                <!-- Vaat fiyattan önce geliyor: ebeveynin kararında en ağır madde bu. -->
                <Label Text="{loc:Translate SubscriptionPitch}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Leaf}"
                       HorizontalTextAlignment="Center" />

                <Border Style="{StaticResource CardBorder}">
                    <CollectionView ItemsSource="{Binding Benefits}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="0,8">
                                    <Label Grid.Column="0"
                                           Text="✓"
                                           FontSize="20"
                                           TextColor="{StaticResource Leaf}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding .}" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

                <Label Text="{loc:Translate SubscriptionActive}"
                       Style="{StaticResource HintLabel}"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding AlreadySubscribed}" />

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Spacing="10">
            <Button Text="{loc:Translate SubscriptionCta}"
                    Style="{StaticResource AccentButton}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                    IsVisible="{Binding AlreadySubscribed, Converter={StaticResource Not}}"
                    Command="{Binding SubscribeCommand}" />

            <Button Text="{loc:Translate SubscriptionRestore}"
                    Style="{StaticResource QuietButton}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                    Command="{Binding RestoreCommand}" />

            <Button Text="{loc:Translate CommonClose}"
                    Style="{StaticResource QuietButton}"
                    Command="{Binding CloseCommand}" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
