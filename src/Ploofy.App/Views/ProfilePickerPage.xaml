<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Ploofy.App.Localization"
             xmlns:ui="clr-namespace:Ploofy.Ui.Controls;assembly=Ploofy.Ui"
             xmlns:vm="clr-namespace:Ploofy.App.ViewModels"
             x:Class="Ploofy.App.Views.ProfilePickerPage"
             x:Name="Page"
             x:DataType="vm:ProfilePickerViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Padding="{StaticResource PagePadding}" RowSpacing="16">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Label Text="{loc:Translate ProfilesTitle}"
                   Style="{StaticResource TitleLabel}"
                   VerticalOptions="Center" />

            <!-- Ayarlar dişlisi ebeveyn kilidinin arkasında. -->
            <Button Grid.Column="1"
                    Text="⚙"
                    FontSize="26"
                    WidthRequest="{StaticResource TouchTarget}"
                    HeightRequest="{StaticResource TouchTarget}"
                    CornerRadius="32"
                    Padding="0"
                    BackgroundColor="{StaticResource SurfaceMuted}"
                    TextColor="{StaticResource Ink}"
                    Command="{Binding OpenSettingsCommand}" />
        </Grid>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Profiles}"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 HorizontalItemSpacing="12"
                                 VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileCard">
                    <!-- Sabit yükseklik yerine en az yükseklik: tablette ve
                         büyük yazı ölçeğinde alt satır kırpılıyordu. -->
                    <Border Style="{StaticResource CardBorder}" MinimumHeightRequest="190">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectCommand, x:DataType=ContentPage}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                            <ui:AvatarBadgeView Avatar="{Binding AvatarId}"
                                                Size="86"
                                                HorizontalOptions="Center" />
                            <Label Text="{Binding DisplayName}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding BandName}"
                                   Style="{StaticResource HintLabel}"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding TotalStars, Converter={StaticResource FormatWith}, ConverterParameter=TotalStars}"
                                   Style="{StaticResource HintLabel}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Label Text="{loc:Translate ProfileLimitReached}"
                   Style="{StaticResource HintLabel}"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding ShowsProfileLimitNote}" />

            <Button Text="{loc:Translate AddProfile}"
                    Style="{StaticResource BigButton}"
                    Command="{Binding AddCommand}" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
