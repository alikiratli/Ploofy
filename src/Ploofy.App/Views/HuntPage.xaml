<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Ploofy.App.Localization"
             xmlns:ui="clr-namespace:Ploofy.Ui.Controls;assembly=Ploofy.Ui"
             xmlns:vm="clr-namespace:Ploofy.App.ViewModels"
             x:Class="Ploofy.App.Views.HuntPage"
             x:Name="Page"
             x:DataType="vm:HuntViewModel">

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*" Padding="{StaticResource PagePadding}" RowSpacing="16">

            <!-- Üst şerit -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12,8">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                    <Label Grid.Column="0" Text="{Binding PlayerAvatar}" FontSize="28" VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding PlayerName}"
                           FontSize="19"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />

                    <FlexLayout Grid.Column="2"
                                BindableLayout.ItemsSource="{Binding Pips}"
                                Wrap="Wrap"
                                JustifyContent="Center"
                                AlignItems="Center"
                                VerticalOptions="Center">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProgressPip">
                                <Label Text="●" FontSize="15" Margin="2,0" TextColor="{Binding Fill}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Label Grid.Column="3"
                           IsVisible="{Binding ShowsProgressCounter}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource InkMuted}"
                           VerticalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Answered}" />
                                <Span Text=" / " />
                                <Span Text="{Binding Total}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Button Grid.Column="4"
                            Text="✕"
                            Style="{StaticResource RoundIconButton}"
                            WidthRequest="48"
                            HeightRequest="48"
                            CornerRadius="24"
                            FontSize="18"
                            Command="{Binding QuitCommand}" />
                </Grid>
            </Border>

            <!-- Aranan işaret. Yönerge yazıya bağlı değil: çocuk bunun
                 aynısını aşağıda buluyor. -->
            <VerticalStackLayout Grid.Row="1" Spacing="6">
                <Label Text="{loc:Translate HuntPrompt}"
                       Style="{StaticResource HintLabel}"
                       HorizontalOptions="Center" />

                <Border Style="{StaticResource CardBorder}"
                        Padding="0"
                        WidthRequest="150"
                        HeightRequest="150"
                        HorizontalOptions="Center">
                    <Label Text="{Binding Target}"
                           FontSize="86"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Ink}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </VerticalStackLayout>

            <!-- Seçenekler -->
            <!-- Seçenekler hedefin hemen altında duruyor. Dikeyde ortalamak
                 tablette hedefle seçenekler arasında koca bir boşluk
                 bırakıyor ve ikisi ayrı ekran gibi görünüyor. -->
            <CollectionView Grid.Row="2"
                            ItemsSource="{Binding Choices}"
                            SelectionMode="None"
                            VerticalOptions="Start">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="{Binding Columns}"
                                     HorizontalItemSpacing="14"
                                     VerticalItemSpacing="14" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HuntChoiceVm">
                        <ui:GlyphTileView Glyph="{Binding Glyph}"
                                          HueIndex="{Binding HueIndex}"
                                          State="{Binding State}"
                                          HeightRequest="160">
                            <ui:GlyphTileView.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.TapCommand, x:DataType=ContentPage}"
                                    CommandParameter="{Binding .}" />
                            </ui:GlyphTileView.GestureRecognizers>
                        </ui:GlyphTileView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Devir katmanı -->
        <Grid IsVisible="{Binding ShowsHandoff}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFC845" Offset="0.0" />
                    <GradientStop Color="#FF8C42" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ConfirmHandoffCommand}" />
            </Grid.GestureRecognizers>

            <VerticalStackLayout VerticalOptions="Center" Spacing="16" Padding="32">
                <Label Text="👋" FontSize="76" HorizontalOptions="Center" />
                <Label Text="{Binding HandoffText}"
                       Style="{StaticResource TitleLabel}"
                       TextColor="White"
                       HorizontalTextAlignment="Center" />
                <Label Text="{loc:Translate HandoffHint}"
                       FontSize="17"
                       TextColor="#F0FFFFFF"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
