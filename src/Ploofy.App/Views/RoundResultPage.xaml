<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Ploofy.App.Localization"
             xmlns:services="clr-namespace:Ploofy.App.Services"
             xmlns:ui="clr-namespace:Ploofy.Ui.Controls;assembly=Ploofy.Ui"
             xmlns:vm="clr-namespace:Ploofy.App.ViewModels"
             x:Class="Ploofy.App.Views.RoundResultPage"
             x:DataType="vm:RoundResultViewModel">

    <Grid>
        <Grid RowDefinitions="*,Auto" Padding="{StaticResource PagePadding}" RowSpacing="20">

            <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" Spacing="18">

                <!-- Kupa, açılışta yaylanarak büyüyor (kod arkası). -->
                <Label x:Name="Trophy"
                       Text="🏆"
                       FontSize="82"
                       HorizontalOptions="Center" />

                <Label Text="{Binding Headline}"
                       Style="{StaticResource TitleLabel}"
                       HorizontalTextAlignment="Center" />

                <Label Text="{Binding GameName}"
                       Style="{StaticResource HintLabel}"
                       HorizontalTextAlignment="Center" />

                <!-- Tek kişilik: yalnızca yıldızlar, kıyas yok. -->
                <ui:StarRow x:Name="SoloStars"
                            Stars="{Binding SoloStars}"
                            StarSize="56"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsMultiplayer, Converter={StaticResource Not}}" />

                <!-- Sıralı oyun: iki çocuğun satırı yan yana. -->
                <CollectionView ItemsSource="{Binding Players}"
                                SelectionMode="None"
                                IsVisible="{Binding IsMultiplayer}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="services:PlayerResult">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <ui:AvatarBadgeView Grid.Column="0"
                                                        Avatar="{Binding AvatarId}"
                                                        Size="52" />

                                    <Label Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center" />

                                    <ui:StarRow Grid.Column="2"
                                                Stars="{Binding Stars}"
                                                StarSize="26"
                                                VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Yeni açılan avatar. Şerit yalnızca bir eşik geçildiğinde
                     görünüyor; dokununca koleksiyona gidiyor, yani ödül
                     kutlandığı yerde kullanılabiliyor. -->
                <Border IsVisible="{Binding HasUnlock}"
                        Style="{StaticResource CardBorder}"
                        Padding="16,12"
                        HorizontalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenCollectionCommand}" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding UnlockText}"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />

                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding UnlockedAvatars}"
                                               Spacing="8"
                                               HorizontalOptions="Center">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <ui:AvatarBadgeView Avatar="{Binding .}" Size="56" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" Spacing="10">
                <Button Text="{loc:Translate PlayAgain}"
                        Style="{StaticResource BigButton}"
                        Command="{Binding PlayAgainCommand}" />
                <Button Text="{loc:Translate BackToGames}"
                        Style="{StaticResource QuietButton}"
                        Command="{Binding BackToGamesCommand}" />
            </VerticalStackLayout>

        </Grid>

        <!-- Konfeti en üstte ve dokunuşları geçiriyor; altındaki düğmeler
             çalışmaya devam ediyor. -->
        <ui:ConfettiView x:Name="Confetti" InputTransparent="True" />
    </Grid>
</ContentPage>
