<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Kategori Ayırma.

    Ekranda tek parça duruyor, altında kutular. Çocuk kutuya dokunuyor —
    sürükleme yok: sorulan tek şey kararın kendisi, parmağın hassasiyeti
    değil. Parçalar emoji ve emoji yalnızca MAUI etiketinde güvenilir
    çiziliyor, o yüzden bu oyunda Skia yüzeyi de yok.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Ploofy.App.Localization"
             xmlns:vm="clr-namespace:Ploofy.App.ViewModels"
             x:Class="Ploofy.App.Views.CategorySortPage"
             x:Name="Page"
             x:DataType="vm:CategorySortViewModel">

    <Grid>
        <Grid RowDefinitions="Auto,*,Auto" Padding="{StaticResource PagePadding}" RowSpacing="14">

            <!-- Üst şerit -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12,8">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                    <Label Grid.Column="0"
                           Text="{Binding PlayerAvatar}"
                           FontSize="28"
                           VerticalOptions="Center" />

                    <Label Grid.Column="1"
                           Text="{Binding PlayerName}"
                           FontSize="19"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />

                    <FlexLayout Grid.Column="2"
                                BindableLayout.ItemsSource="{Binding Pips}"
                                Wrap="Wrap"
                                JustifyContent="Center"
                                AlignItems="Center"
                                VerticalOptions="Center">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProgressPip">
                                <Label Text="●" FontSize="15" Margin="2,0" TextColor="{Binding Fill}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Label Grid.Column="3"
                           IsVisible="{Binding ShowsProgressCounter}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource InkMuted}"
                           VerticalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Sorted}" />
                                <Span Text=" / " />
                                <Span Text="{Binding Total}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Button Grid.Column="4"
                            Text="✕"
                            Style="{StaticResource RoundIconButton}"
                            WidthRequest="48"
                            HeightRequest="48"
                            CornerRadius="24"
                            FontSize="18"
                            Command="{Binding QuitCommand}" />
                </Grid>
            </Border>

            <!-- Ayrılacak parça. Sıradaki arkada soluk duruyor: turun bir
                 kuyruk olduğunu ve sonunun yaklaştığını gösteriyor. -->
            <Grid Grid.Row="1" VerticalOptions="Center">
                <Label Text="{Binding NextGlyph}"
                       IsVisible="{Binding HasNext}"
                       FontSize="64"
                       Opacity="0.25"
                       Margin="0,0,0,90"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />

                <Label Text="{Binding CurrentGlyph}"
                       FontSize="128"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Grid>

            <!-- Kutular. Dokunma hedefi kasten büyük: en küçük bantta iki
                 kutu ekranı paylaşıyor, en zorunda üç. -->
            <FlexLayout Grid.Row="2"
                        BindableLayout.ItemsSource="{Binding Bins}"
                        JustifyContent="SpaceEvenly"
                        AlignItems="End">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryBin">
                        <Border Padding="18,14"
                                Margin="6,0"
                                MinimumWidthRequest="120"
                                StrokeThickness="4"
                                StrokeShape="RoundRectangle 26"
                                BackgroundColor="{StaticResource Surface}">

                            <!-- Geri bildirim kutunun kendi kenarında: çocuğun
                                 bakışı dokunduğu yerde. -->
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding State}" Value="Idle">
                                    <Setter Property="Stroke" Value="{StaticResource SurfaceMuted}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding State}" Value="Correct">
                                    <Setter Property="Stroke" Value="{StaticResource Correct}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding State}" Value="Wrong">
                                    <Setter Property="Stroke" Value="{StaticResource Retry}" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.DropCommand, x:DataType=ContentPage}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Glyph}"
                                       FontSize="46"
                                       HorizontalOptions="Center" />
                                <Label Text="{Binding Name}"
                                       IsVisible="{Binding Source={x:Reference Page}, Path=BindingContext.ShowsBinNames, x:DataType=ContentPage}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Ink}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

        </Grid>

        <!-- Devir katmanı -->
        <Grid IsVisible="{Binding ShowsHandoff}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFC845" Offset="0.0" />
                    <GradientStop Color="#FF8C42" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ConfirmHandoffCommand}" />
            </Grid.GestureRecognizers>

            <VerticalStackLayout VerticalOptions="Center" Spacing="16" Padding="32">
                <Label Text="👋" FontSize="76" HorizontalOptions="Center" />
                <Label Text="{Binding HandoffText}"
                       Style="{StaticResource TitleLabel}"
                       TextColor="White"
                       HorizontalTextAlignment="Center" />
                <Label Text="{loc:Translate HandoffHint}"
                       FontSize="17"
                       TextColor="#F0FFFFFF"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
