<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Ploofy.App.Localization"
             xmlns:ui="clr-namespace:Ploofy.Ui.Controls;assembly=Ploofy.Ui"
             xmlns:vm="clr-namespace:Ploofy.App.ViewModels"
             x:Class="Ploofy.App.Views.ProfileEditorPage"
             x:Name="Page"
             x:DataType="vm:ProfileEditorViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="20">

            <!-- Başlık görünüm modelinden geliyor: aynı ekran hem ekleme hem düzenleme. -->
            <Label Text="{Binding HeaderText}" Style="{StaticResource TitleLabel}" />

            <VerticalStackLayout Spacing="6">
                <Label Text="{loc:Translate ProfileNameLabel}" Style="{StaticResource SectionLabel}" />
                <Entry Text="{Binding DisplayName}"
                       MaxLength="24"
                       FontSize="20"
                       HeightRequest="{StaticResource TouchTarget}"
                       BackgroundColor="{StaticResource Surface}" />
                <Label Text="{loc:Translate ProfileNameHint}" Style="{StaticResource HintLabel}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Label Text="{loc:Translate ProfileAgeLabel}" Style="{StaticResource SectionLabel}" />

                <CollectionView ItemsSource="{Binding Bands}"
                                SelectedItem="{Binding SelectedBand}"
                                SelectionMode="Single"
                                HeightRequest="270">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BandOption">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label FontSize="20" FontAttributes="Bold">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Name}" />
                                                <Span Text="  " />
                                                <Span Text="{Binding AgeRange}"
                                                      TextColor="{StaticResource InkMuted}"
                                                      FontSize="16" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="{Binding Hint}" Style="{StaticResource HintLabel}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="12">
                <Label Text="{loc:Translate ProfileAvatarLabel}" Style="{StaticResource SectionLabel}" />

                <!-- Gruplar iç içe BindableLayout ile çiziliyor, CollectionView
                     ile değil: ScrollView içinde kendi kaydırması olan bir
                     liste hem parmağı çalıyor hem de sabit yükseklik
                     istiyor. Buradaki seçenek sayısı belli ve az. -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding AvatarGroups}"
                                     Spacing="14">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AvatarGroupVm">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Name}" Style="{StaticResource HintLabel}" />

                                <FlexLayout BindableLayout.ItemsSource="{Binding Choices}"
                                            Wrap="Wrap"
                                            JustifyContent="Start"
                                            AlignItems="Center">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AvatarChoice">
                                            <!-- Henüz kazanılmamış avatar soluk duruyor ve
                                                 altında gereken yıldız yazılı. Gizlenmiyor:
                                                 ebeveynin "yıldız ne işe yarıyor" sorusunun
                                                 cevabı da burası. -->
                                            <VerticalStackLayout Margin="4"
                                                                 Spacing="2"
                                                                 WidthRequest="76">
                                                <VerticalStackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectAvatarCommand, x:DataType=ContentPage}"
                                                        CommandParameter="{Binding .}" />
                                                </VerticalStackLayout.GestureRecognizers>

                                                <Grid HorizontalOptions="Center" Opacity="{Binding Opacity}">
                                                    <ui:AvatarBadgeView Avatar="{Binding Emoji}"
                                                                        IsSelected="{Binding IsSelected}"
                                                                        Size="68" />

                                                    <Label Text="🔒"
                                                           FontSize="20"
                                                           IsVisible="{Binding IsLocked}"
                                                           HorizontalOptions="End"
                                                           VerticalOptions="End" />
                                                </Grid>

                                                <Label Text="{Binding RequirementText}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource InkMuted}"
                                                       IsVisible="{Binding IsLocked}"
                                                       HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Günlük oyun süresi. Profilin kendi ayarı, tıpkı yaş bandı
                 gibi: kardeşlerin bütçeleri ayrı. Varsayılan "sınırsız" ve
                 listede ilk sırada — sınır koymak ebeveynin bilinçli kararı
                 olmalı, varsayılan değil. -->
            <VerticalStackLayout Spacing="10">
                <Label Text="{loc:Translate ProfileScreenTimeLabel}"
                       Style="{StaticResource SectionLabel}" />

                <FlexLayout BindableLayout.ItemsSource="{Binding ScreenTimeOptions}"
                            Wrap="Wrap"
                            AlignItems="Center">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScreenTimeOption">
                            <Border Margin="0,0,8,8"
                                    Padding="16,8"
                                    StrokeShape="RoundRectangle 999"
                                    Stroke="Transparent">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Sky}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceMuted}" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectScreenTimeCommand, x:DataType=ContentPage}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Label Text="{Binding Label}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Ink}" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Label Text="{Binding ScreenTimeHint}" Style="{StaticResource HintLabel}" />
            </VerticalStackLayout>

            <Button Text="{loc:Translate ProfileSave}"
                    Style="{StaticResource BigButton}"
                    IsEnabled="{Binding CanSave}"
                    Command="{Binding SaveCommand}" />

            <Button Text="{loc:Translate CommonCancel}"
                    Style="{StaticResource QuietButton}"
                    Command="{Binding CancelCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
