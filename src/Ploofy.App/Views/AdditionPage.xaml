<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Basit Toplama.

    Soru ekranın ortasında ve iki tarafı var. Fidan'da ikisi de nesne kümesi
    ("üç elma ve iki elma"); Meşe'de sol taraf rakam, sağ taraf küme — yani
    "üçten devam et". Saymanın bir sonraki adımı bu, ve iki yerleşim aynı
    ızgarada duruyor: hangisinin görüneceğine bant karar veriyor.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Ploofy.App.Localization"
             xmlns:vm="clr-namespace:Ploofy.App.ViewModels"
             x:Class="Ploofy.App.Views.AdditionPage"
             x:Name="Page"
             x:DataType="vm:AdditionViewModel">

    <Grid>
        <Grid RowDefinitions="Auto,*,Auto" Padding="{StaticResource PagePadding}" RowSpacing="14">

            <!-- Üst şerit -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12,8">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                    <Label Grid.Column="0"
                           Text="{Binding PlayerAvatar}"
                           FontSize="28"
                           VerticalOptions="Center" />

                    <Label Grid.Column="1"
                           Text="{Binding PlayerName}"
                           FontSize="19"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />

                    <FlexLayout Grid.Column="2"
                                BindableLayout.ItemsSource="{Binding Pips}"
                                Wrap="Wrap"
                                JustifyContent="Center"
                                AlignItems="Center"
                                VerticalOptions="Center">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProgressPip">
                                <Label Text="●" FontSize="15" Margin="2,0" TextColor="{Binding Fill}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Label Grid.Column="3"
                           IsVisible="{Binding ShowsProgressCounter}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource InkMuted}"
                           VerticalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Answered}" />
                                <Span Text=" / " />
                                <Span Text="{Binding Total}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Button Grid.Column="4"
                            Text="✕"
                            Style="{StaticResource RoundIconButton}"
                            WidthRequest="48"
                            HeightRequest="48"
                            CornerRadius="24"
                            FontSize="18"
                            Command="{Binding QuitCommand}" />
                </Grid>
            </Border>

            <!-- Soru: [sol] + [sağ] = ? -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,Auto,*,Auto,Auto"
                  ColumnSpacing="12"
                  VerticalOptions="Center">

                <!-- Sol taraf: küme ya da rakam, ikisi aynı hücrede -->
                <Grid Grid.Column="0">
                    <FlexLayout BindableLayout.ItemsSource="{Binding LeftObjects}"
                                IsVisible="{Binding ShowsLeftObjects}"
                                Wrap="Wrap"
                                JustifyContent="Center"
                                AlignItems="Center">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding .}" FontSize="46" Margin="4" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Label Text="{Binding LeftNumber}"
                           IsVisible="{Binding ShowsLeftObjects, Converter={StaticResource Not}}"
                           FontSize="96"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Ink}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Grid>

                <Label Grid.Column="1"
                       Text="+"
                       FontSize="52"
                       FontAttributes="Bold"
                       TextColor="{StaticResource InkMuted}"
                       VerticalOptions="Center" />

                <FlexLayout Grid.Column="2"
                            BindableLayout.ItemsSource="{Binding RightObjects}"
                            Wrap="Wrap"
                            JustifyContent="Center"
                            AlignItems="Center">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Label Text="{Binding .}" FontSize="46" Margin="4" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Label Grid.Column="3"
                       Text="="
                       FontSize="52"
                       FontAttributes="Bold"
                       TextColor="{StaticResource InkMuted}"
                       VerticalOptions="Center" />

                <Label Grid.Column="4"
                       Text="?"
                       FontSize="72"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Sky}"
                       VerticalOptions="Center" />
            </Grid>

            <!-- Seçenekler -->
            <FlexLayout Grid.Row="2"
                        BindableLayout.ItemsSource="{Binding Choices}"
                        JustifyContent="SpaceEvenly"
                        AlignItems="Center">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:AdditionChoice">
                        <Border Margin="6,0"
                                Padding="0"
                                WidthRequest="96"
                                HeightRequest="96"
                                StrokeThickness="4"
                                StrokeShape="RoundRectangle 26"
                                BackgroundColor="{StaticResource Surface}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding State}" Value="Idle">
                                    <Setter Property="Stroke" Value="{StaticResource SurfaceMuted}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding State}" Value="Correct">
                                    <Setter Property="Stroke" Value="{StaticResource Correct}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding State}" Value="Wrong">
                                    <Setter Property="Stroke" Value="{StaticResource Retry}" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.AnswerCommand, x:DataType=ContentPage}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Label Text="{Binding Text}"
                                   FontSize="48"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Ink}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

        </Grid>

        <!-- Devir katmanı -->
        <Grid IsVisible="{Binding ShowsHandoff}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFC845" Offset="0.0" />
                    <GradientStop Color="#FF8C42" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ConfirmHandoffCommand}" />
            </Grid.GestureRecognizers>

            <VerticalStackLayout VerticalOptions="Center" Spacing="16" Padding="32">
                <Label Text="👋" FontSize="76" HorizontalOptions="Center" />
                <Label Text="{Binding HandoffText}"
                       Style="{StaticResource TitleLabel}"
                       TextColor="White"
                       HorizontalTextAlignment="Center" />
                <Label Text="{loc:Translate HandoffHint}"
                       FontSize="17"
                       TextColor="#F0FFFFFF"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
