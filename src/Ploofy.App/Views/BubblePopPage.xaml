<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Ploofy.App.Localization"
             xmlns:ui="clr-namespace:Ploofy.Ui.Controls;assembly=Ploofy.Ui"
             xmlns:vm="clr-namespace:Ploofy.App.ViewModels"
             x:Class="Ploofy.App.Views.BubblePopPage"
             x:Name="Page"
             x:DataType="vm:BubblePopViewModel">

    <Grid>
        <!-- Oyun yüzeyi bütün sayfayı kaplıyor; bilgi şeridi üstünde yüzüyor.
             Balonlar şeridin altından geçip görünmeye devam ediyor, yani
             oynanan alan ekranın tamamı. -->
        <ui:BubbleSurface x:Name="Surface" />

        <!-- Bilgi şeridi -->
        <Border VerticalOptions="Start"
                Margin="14,14,14,0"
                Padding="14,10"
                StrokeShape="RoundRectangle 26"
                Stroke="Transparent"
                BackgroundColor="#F2FFFFFF">
            <Border.Shadow>
                <Shadow Brush="#40000000" Offset="0,4" Radius="12" Opacity="0.5" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">

                <Label Grid.Column="0"
                       Text="{Binding PlayerAvatar}"
                       FontSize="26"
                       VerticalOptions="Center" />

                <!-- Hedef renk: "şu renge dokun" yönergesinin yazısız hâli.
                     Okuma bilmeyen çocuk rengi görüp eşleştiriyor. -->
                <Border Grid.Column="1"
                        IsVisible="{Binding ShowsTarget}"
                        WidthRequest="42"
                        HeightRequest="42"
                        Padding="0"
                        StrokeShape="RoundRectangle 21"
                        StrokeThickness="3"
                        Stroke="White"
                        BackgroundColor="{Binding TargetColor}"
                        VerticalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#50000000" Offset="0,2" Radius="6" />
                    </Border.Shadow>
                </Border>

                <!-- İlerleme: dolan balon işaretleri. Sayı yok, çünkü küçük
                     bantlarda okunmuyor; dolan işaretler her yaşta anlaşılıyor. -->
                <FlexLayout Grid.Column="2"
                            BindableLayout.ItemsSource="{Binding Pips}"
                            Wrap="Wrap"
                            JustifyContent="Center"
                            AlignItems="Center"
                            VerticalOptions="Center">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProgressPip">
                            <Label Text="●"
                                   FontSize="15"
                                   Margin="2,0"
                                   TextColor="{Binding Fill}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Label Grid.Column="3"
                       Text="{Binding TimerText}"
                       IsVisible="{Binding ShowsTimer}"
                       FontSize="20"
                       FontAttributes="Bold"
                       VerticalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsTimeRunningOut}" Value="True">
                            <Setter Property="TextColor" Value="{StaticResource Berry}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <Button Grid.Column="4"
                        Text="✕"
                        FontSize="18"
                        WidthRequest="48"
                        HeightRequest="48"
                        CornerRadius="24"
                        Padding="0"
                        BackgroundColor="{StaticResource SurfaceMuted}"
                        TextColor="{StaticResource Ink}"
                        Command="{Binding QuitCommand}" />
            </Grid>
        </Border>

        <!-- Devir katmanı: sıra kardeşe geçerken oyun alanını tamamen kapatıyor. -->
        <Grid IsVisible="{Binding ShowsHandoff}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource Sun}" Offset="0.0" />
                    <GradientStop Color="{StaticResource Coral}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ConfirmHandoffCommand}" />
            </Grid.GestureRecognizers>

            <VerticalStackLayout VerticalOptions="Center" Spacing="16" Padding="32">
                <Label Text="👋" FontSize="76" HorizontalOptions="Center" />
                <Label Text="{Binding HandoffText}"
                       Style="{StaticResource TitleLabel}"
                       TextColor="White"
                       HorizontalTextAlignment="Center" />
                <Label Text="{loc:Translate HandoffHint}"
                       FontSize="17"
                       TextColor="#F0FFFFFF"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
