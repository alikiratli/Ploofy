<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Yayın hedefleri Android ve iOS. Windows yalnızca geliştirme sırasında
		     hızlı denemek için; mağazaya çıkmıyor. -->
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Ploofy.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

		<ApplicationTitle>Ploofy</ApplicationTitle>
		<ApplicationId>io.ploofy.app</ApplicationId>

		<!-- Kullanıcının gördüğü sürüm ve mağazanın saydığı yapı numarası.
		     ApplicationVersion (Android'de versionCode) Play'e yüklenen her
		     paket için artmak zorunda; aynı numarayla ikinci bir yükleme
		     kabul edilmiyor. Numaranın aralıksız artması gerekmiyor, yalnızca
		     büyümesi.

		     2 = internal testing'e giden ilk paket. 1 hiç yüklenmedi ve
		     kullanılmayacak: minSdk 21 ile üretilmiş bir paket o numarayı
		     taşıyordu ve numarayı boş bırakmak, elde kalan eski bir .aab'nin
		     yanlışlıkla yüklenmesini imkânsız kılıyor.

		     ApplicationDisplayVersion 1.0'da kalıyor: kullanıcının gördüğü
		     sürüm bu ve internal testing bir yayın değil. -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>

		<!-- MVVM ureticisi [ObservableProperty] icin partial property biciminde
		     kod uretiyor; WinUI hedefinde alan bicimi MVVMTK0045 ile hata
		     veriyor. Uretici bu bicimi yalnizca preview dil surumunde
		     isliyor, bu yuzden burada acik. Motor ve veri katmani stabil
		     dil surumunde kaliyor. -->
		<LangVersion>preview</LangVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<!-- Android 8.0. Alt sinir emojiden geliyor, API'den degil: avatarlarin
		     bir kismi (peri, buyucu, deniz kizi) Unicode 10 ile geldi ve o
		     karakterler ancak 8.0'in sistem yazi tipinde var. Daha dusuk bir
		     sinirda cocuk, koleksiyon ve profil ekranlarinda bos kutular
		     goruyordu - yani odul sisteminin tamami kirikti.

		     21 (Android 5.0) beyani zaten oldugundan genisti: pakette yalnizca
		     arm64-v8a ve x86_64 var, o cagin 32 bit ARM cihazlari kuramiyordu.
		     26, beyani gerceklige esitliyor. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!--
		Android yayın imzası.

		Anahtar ve parolalar depoya girmiyor; dört değer dışarıdan geliyor ve
		iki yol da çalışıyor:

		  - Kök dizindeki Ploofy.local.props (zaten .gitignore'da), ya da
		  - aynı adlı ortam değişkenleri (CI için) — MSBuild ortam
		    değişkenlerini özellik olarak görüyor.

		PloofyKeystore, PloofyKeystoreAlias, PloofyKeystorePassword,
		PloofyKeyPassword. Ayrıntı ve keytool komutu README'de.

		Değerler yoksa derleme durmuyor: sürüm paketi hata ayıklama
		anahtarıyla imzalanıp çıkıyor, bu da cihazda deneme için yeterli.
		Aşağıdaki uyarı yanlışlıkla o paketi mağazaya yüklemeyi engellemek
		için var — Play, hata ayıklama sertifikasını reddediyor.
	-->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'
	                          and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'
	                          and '$(PloofyKeystore)' != ''">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>$(PloofyKeystore)</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>$(PloofyKeystoreAlias)</AndroidSigningKeyAlias>
		<AndroidSigningStorePass>$(PloofyKeystorePassword)</AndroidSigningStorePass>
		<AndroidSigningKeyPass>$(PloofyKeyPassword)</AndroidSigningKeyPass>
	</PropertyGroup>

	<Target Name="PloofyUyarSurumImzasiYok"
	        BeforeTargets="Build"
	        Condition="'$(Configuration)' == 'Release'
	                   and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'
	                   and '$(PloofyKeystore)' == ''">
		<Warning Text="Yayın anahtarı tanımlı değil (PloofyKeystore); paket hata ayıklama sertifikasıyla imzalanacak ve Play bunu reddeder. Kurulum README'de, 'Yayın imzası' başlığı." />
	</Target>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FFD166" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFD166" BaseSize="128,128" />

		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
		<!-- MVVM üretici: ObservableProperty / RelayCommand kaynak üretimiyle
		     görünüm modellerinde standart kalıp kodu yazmıyoruz. -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

		<!--
			Yerel SQLite'ın yamalı sürümü. Gerekçesi Ploofy.Data.csproj'da;
			platforma özel değişkenler burada, çünkü Android/iOS varlıklarını
			çözen proje bu.
		-->
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.13"
		                  Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.ios" Version="2.1.13"
		                  Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />

		<!--
			Genel (platformsuz) paketten yalnızca sürüm numarası lazım; taşıdığı
			yerel kütüphaneleri almıyoruz. Sebebi ince: pakette Android yapısı
			yok, ama RID grafiğinde android-x64 linux-x64'ün altında duruyor, bu
			yüzden NuGet masaüstü Linux derlemesini Android için uygun sayıyor
			ve yukarıdaki AAR'dan gelen gerçek Android kütüphanesinin önüne
			geçiyor (XA4301 "zaten içeriyor" uyarısı bunu söylüyor). Sonuç: APK
			glibc'ye bağlı bir .so taşıyor ve 16 KB sayfa hizalaması bozuluyor.
			ExcludeAssets="native" ile yerel varlık yolu kapanıyor.

			Windows hedefinde bu koşul çalışmıyor: orada paketin kendi
			e_sqlite3.dll'i doğru olanı.
		-->
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" ExcludeAssets="native"
		                  Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'
		                             or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Ploofy.Data\Ploofy.Data.csproj" />
		<ProjectReference Include="..\Ploofy.Engine\Ploofy.Engine.csproj" />
		<ProjectReference Include="..\Ploofy.Ui\Ploofy.Ui.csproj" />
	</ItemGroup>

</Project>
