<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!--
		appCategory="game" bir sınıflandırma etiketinden fazlası: API 36'yı
		hedefleyen uygulamalarda Android, sw600dp'den geniş ekranlarda
		screenOrientation'ı yok sayıyor — yani MainActivity'deki yatay kilit
		tam hedef cihazımızda, tablette geçersiz kalacaktı. Oyunlar bu
		değişiklikten muaf ve muafiyet bu bayrakla belirleniyor.

		Etiket zaten doğru: uygulama on mini oyundan oluşuyor. Kaldırılırsa
		her oyun için ikinci bir dikey yerleşim yazmak gerekir.
	-->
	<application android:allowBackup="false" android:appCategory="game" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true"></application>

	<!--
		Titreşim, geri bildirimin yarısı: doğru dokunuşta kısa bir titreşim,
		bu yaş grubunda animasyondan daha güçlü çalışıyor. Normal izin
		sınıfında olduğu için çalışırken kullanıcıya soru sorulmuyor.
	-->
	<uses-permission android:name="android.permission.VIBRATE" />

	<!--
		INTERNET ve ACCESS_NETWORK_STATE yalnızca mağaza (satın alma) katmanı
		için. Uygulama kendi sunucusuna bağlanmıyor, çocuğa ait hiçbir veri
		cihazdan çıkmıyor; oyunların tamamı çevrimdışı çalışıyor.
	-->
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
