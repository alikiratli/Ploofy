<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Ploofy.App.Localization"
             xmlns:theme="clr-namespace:Ploofy.Ui.Theme;assembly=Ploofy.Ui"
             x:Class="Ploofy.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Tema Ploofy.Ui'den geliyor: ileride ikinci bir oyun ailesi
                     aynı görsel dili paylaşabilsin diye uygulamada değil. -->
                <theme:PloofyColors />
                <theme:PloofyStyles />
            </ResourceDictionary.MergedDictionaries>

            <loc:FormatWithConverter x:Key="FormatWith" />
            <loc:InvertBoolConverter x:Key="Not" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
